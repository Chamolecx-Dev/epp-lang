// ═══════════════════════════════════════════════════════════════
//  MI PRIMER JUEGO EN E++
//  Un juego de recolectar monedas y evitar obstaculos
//  Escribe: python interprete.py mi_juego.epp
// ═══════════════════════════════════════════════════════════════

// --- Configuracion de la pantalla ---
Resolucion de la pantalla de prueba en 800x600
titulo = "Mi Primer Juego E++ - Recolecta Monedas!"
Fondo color "noche"

// --- Variables del juego ---
puntuacion = 0
vidas_jugador = 3

// --- Crear entidades ---

// El jugador (cuadrado verde)
Genera un "jugador", en "Centro"

// Monedas para recolectar (circulos amarillos)
Genera un "moneda", en "100, 100"
Genera un "moneda2", en "200, 150"
Genera un "moneda3", en "500, 80"
Genera un "moneda4", en "650, 200"
Genera un "moneda5", en "400, 300"

// Bloques enemigos (cuadrados rojos)
Genera un "bloque", en "150, 300"
Genera un "bloque2", en "600, 400"
Genera un "bloque3", en "350, 200"

// --- Controles del jugador ---

Al presionar tecla "derecha":
    Mueve "jugador" hacia "derecha" por 8
fin

Al presionar tecla "izquierda":
    Mueve "jugador" hacia "izquierda" por 8
fin

Al presionar tecla "arriba":
    Mueve "jugador" hacia "arriba" por 8
fin

Al presionar tecla "abajo":
    Mueve "jugador" hacia "abajo" por 8
fin

// --- Mensaje de inicio ---
di: "========================================"
di: "  BIENVENIDO A MI JUEGO E++!"
di: ""
di: "  Controles:"
di: "    FLECHAS - Mover el jugador verde"
di: ""
di: "  Objetivo:"
di: "    Recolecta todas las monedas amarillas"
di: "    Evita los bloques rojos!"
di: "========================================"
